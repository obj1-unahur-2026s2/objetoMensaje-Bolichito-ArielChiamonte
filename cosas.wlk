// Colores
object rojo {
	method esFuerte() { return true }
}
object celeste {
	method esFuerte() { return false }
}
object verde {
	method esFuerte() { return true }
}
object naranja {
	method esFuerte() { return true }
}
object pardo {
	method esFuerte() { return false }
}

// Materiales
object cobre {
	method brilla() { return true }
}
object vidrio {
	method brilla() { return true }
}
object cuero {
	method brilla() { return false }
}
object madera {
	method brilla() { return false }
}
object lino {
	method brilla() { return false }
}